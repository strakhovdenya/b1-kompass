{
  "$schema": "https://raw.githubusercontent.com/strakhovdenya/dark-factory/v0.1.3/profile/schema.json",
  "branchTemplate": "task/ISSUE-{issue}-{slug}",
  "apps": [
    {
      "name": "web",
      "path": "apps/web"
    }
  ],
  "docOnlyPathPatterns": ["**/*.md", "**/docs/"],
  "protectedPaths": [".claude/", ".github/", ".git/"],
  "docs": {
    "prd": "docs/prd",
    "plans": "docs/plans"
  },
  "verifier": {
    "checks": [
      "spec-approval",
      "affects-scope",
      "computed-items",
      "test-tampering-scan",
      "references",
      "ci-checks",
      "allowed-model"
    ]
  },
  "ralph": {
    "enabled": false
  },
  "judge": {
    "enabled": false
  }
}
