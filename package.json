{
  "name": "b1-kompass",
  "version": "0.1.0",
  "private": true,
  "description": "B1 Kompass — online German A2–B1 exam trainer (DTZ Hören and Lesen). See apps/web and packages/domain.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/domain",
    "apps/web"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "npm run build --workspace apps/web",
    "test:e2e": "npm run test:e2e --workspace apps/web",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:stop": "supabase stop",
    "seed:pilot": "tsx scripts/seed-pilot-question.ts",
    "publish:pilot": "tsx scripts/publish-pilot.ts",
    "prepare:pilot": "tsx scripts/prepare-pilot/prepare-pilot.ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@types/node": "24.19.2",
    "dark-factory": "github:strakhovdenya/dark-factory#v0.1.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 80
  },
  "type": "module"
}
