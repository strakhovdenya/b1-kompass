# Server-only settings of the Next.js app. Never prefix them with NEXT_PUBLIC_.
# Local values: `npx supabase status -o env` (API_URL and SECRET_KEY).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
# The one exact origin of this deployment (scheme, host, port; no path, no
# wildcard). Runtime commands are refused when the Origin of a request differs
# or when this is missing. On a Vercel preview without it, https:// plus
# VERCEL_URL is used; production always needs it set.
APP_ORIGIN=http://localhost:3000
# Word dictionary (optional). A contact email raises the free MyMemory limit
# (5000 -> 50000 characters a day) and is the contact of the OpenThesaurus
# User-Agent; without it the deployment origin is used as the contact.
DICTIONARY_CONTACT_EMAIL=
# Test only: 1 replaces MyMemory/OpenThesaurus with a local fake for the e2e
# servers. Refused (no lookups at all) on Vercel or with a non-loopback
# APP_ORIGIN. Leave empty everywhere else.
DICTIONARY_TEST_PROVIDER=
